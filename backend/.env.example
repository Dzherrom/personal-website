DEBUG=True
SECRET_KEY=dev-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite en local (dejar DATABASE_URL vacío)
DATABASE_URL=

# Render Postgres (solo en el panel de Render, NO commitear credenciales)
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/NOMBRE_BD
# DATABASE_SSL=true

# Admin local (setup_local.ps1)
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=admin@localhost
DJANGO_ADMIN_PASSWORD=admin123

# URL pública del frontend (referencia al rellenar URLs en el admin)
SITE_PUBLIC_URL=https://dzherrom.netlify.app

# Alternativa avanzada: almacenamiento S3/R2 (subir archivos desde el admin)
# AWS_STORAGE_BUCKET_NAME=mi-bucket
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_S3_ENDPOINT_URL=https://....r2.cloudflarestorage.com
# AWS_S3_CUSTOM_DOMAIN=https://pub-....r2.dev
# AWS_S3_REGION_NAME=auto
